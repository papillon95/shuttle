{
  "name": "shuttle",
  "productName": "Shuttle",
  "version": "0.3.33",
  "description": "Shuttle（梭子）桌面 AI 助手（Electron）：登录后使用平台大模型操作本地文件和代码，服务端为 mamahug 若依后端的 aidesk 产品线",
  "main": "boot.js",
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "release": "node scripts/release.mjs",
    "ship": "node scripts/ship.mjs"
  },
  "build": {
    "appId": "site.richbrian.shuttle",
    "productName": "Shuttle",
    "copyright": "Copyright © 2026 richbrian.site",
    "artifactName": "Shuttle-${version}-${os}-${arch}.${ext}",
    "files": [
      "boot.js",
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Shuttle 需要使用麦克风进行语音输入（Shuttle uses the microphone for voice input）"
      },
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": null
    },
    "dmg": {
      "title": "Shuttle ${version}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signtoolOptions": {
        "sign": "./scripts/win-sign.js"
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Shuttle"
    },
    "afterPack": "./scripts/mac-adhoc-sign.js"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "cos-nodejs-sdk-v5": "^3.0.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "mysql2": "^3.11.0"
  },
  "author": "richbrian.site"
}
